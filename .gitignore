# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent scaffolding regenerated by `next dev`
AGENTS.md
CLAUDE.md
.claude/

# local environment and generated catalog export
.env
!.env.example
**/.next/
dev-server.log
dev-server.err.log
backend/seed/catalog.json

# uploaded product photographs, in development. In the container these live on
# a Docker volume instead. Either way they are data, not source.
/data/uploads


# the hero source image; the sized WebPs in public/ are what ships
/bg.png
/bgwhite.png

# raw pixel dumps from image measuring scripts
*.rgb

# workspace build output
/shared/dist
/backend/dist
backups/*.sql
